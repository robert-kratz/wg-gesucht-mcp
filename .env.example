# Paths are resolved relative to this file when loaded using --env-file.
WG_MCP_CONFIG=./accounts.json
WG_MCP_DATA_DIR=./.data
WG_MCP_READ_ONLY=true
WG_MCP_HEADLESS=true
# Use chrome for locally installed Google Chrome, or chromium for Playwright's browser.
WG_MCP_BROWSER_CHANNEL=chromium
# Optional, comma-separated directories from which local attachment staging is allowed.
WG_MCP_ATTACHMENT_ROOTS=
# Optional. Omit both for manual browser login.
WG_PERSONAL_EMAIL=
WG_PERSONAL_PASSWORD=
WG_OTHER_EMAIL=
WG_OTHER_PASSWORD=
