{
  "name": "wg-gesucht-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A local, multi-account Playwright bridge between WG-Gesucht and MCP clients.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.32.1",
  "bin": {
    "wg-gesucht-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "SETUP.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "accounts.example.json",
    ".env.example"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "browsers:install": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "dotenv": "18.0.9",
    "playwright": "1.64.1",
    "proper-lockfile": "4.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.22.4",
    "typescript": "6.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
